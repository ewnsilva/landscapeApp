{
  "expo": {
    "name": "14ndscapes",
    "slug": "landscapeApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "landscapeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/favicon.png",
      "bundleIdentifier": "14ndscapeApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1b1b",
        "foregroundImage": "./assets/images/favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ewremotedev.14ndscapeApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5177c670-ced0-4c35-9462-41f0c30d89ed"
      }
    }
  }
}
